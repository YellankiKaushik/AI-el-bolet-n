# Copy to .env, then edit. Do not commit real secrets.
HOST=127.0.0.1
APP_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:8787
ADMIN_PASSWORD=replace-with-a-strong-unique-password
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_PATH=data/signal_daily.db
OLLAMA_URL=http://127.0.0.1:11434
# Run "ollama list" and set the exact model tag installed on your laptop.
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=240
RSS_LIMIT=80
RSS_MAX_AGE_DAYS=14
RSS_RETRIES=1
DELIVERY_BATCH_SIZE=25
# On remote production servers set this false; import laptop-generated JSON instead.
ENABLE_LOCAL_GENERATION=true
# No outgoing mail until deliberately enabled and a verified sender is configured.
EMAIL_DELIVERY_ENABLED=false
# Production WSGI trusts exactly one reverse proxy IP. Never use '*'.
TRUSTED_PROXY=127.0.0.1
# Docker production only: public DNS name (no scheme/path) and operator public IP/VPN CIDR.
# PUBLIC_HOST=newsletter.example.com
# EDITOR_CIDR=203.0.113.10/32

# These values are required for real subscriptions + email distribution.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASSWORD=your-smtp-password
# MAIL_FROM=Signal Daily <newsletter@your-domain.com>
# SMTP_SSL=false

# Optional custom feeds: label|https://feedurl,label|https://feedurl
# RSS_FEEDS=Hugging Face|https://huggingface.co/blog/feed.xml,arXiv AI|https://rss.arxiv.org/rss/cs.AI
